# libevring Buck2 Configuration
#
# Verified event ring for agentic LLM infrastructure.
# Reset-on-ambiguity: upstream ambiguity must reset the connection.
#
# Hermetic builds with Nix store paths from sensenet flake module.
# Toolchain paths are set in .buckconfig.local (generated by nix develop).

[cells]
root = .
prelude = nix/build/prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
fbcode_macros = none
buck = none

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[buck2]
materializations = deferred
digest_algorithms = BLAKE3

[build]
execution_platforms = toolchains//:local
