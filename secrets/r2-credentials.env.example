# R2 Credentials for weapon telemetry
# Copy this to r2-credentials.env and fill in values, then encrypt with agenix

# Cloudflare Account ID (from dashboard URL or API)
R2_ACCOUNT_ID=bb63fff6a3d0856513474ee20860a81a

# R2 API Token credentials (create at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
# Permissions needed: Object Read & Write for weapon-telemetry bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name
R2_BUCKET=weapon-telemetry
