cabal-version:   3.0
name:            weapon-server
version:         0.1.0.0
synopsis:        Haskell server for Weapon AI coding agent
description:
  Haskell implementation of the Weapon AI coding agent server backend.
  .
  Features:
  .
  * Full API parity with TypeScript reference (95 endpoints)
  * Session management with persistent storage
  * LLM integration (Anthropic, OpenRouter)
  * Tool execution (read, write, edit, bash, glob, grep)
  * PTY terminals with WebSocket bridge
  * SSE event streaming
  * Sandboxed execution via bubblewrap

license:         MIT
license-file:    LICENSE
author:          Straylight Software
maintainer:      dev@straylight.ai
copyright:       2026 Straylight Software
category:        Web, AI
build-type:      Simple
homepage:        https://github.com/straylight-software/weapon-server-hs
bug-reports:
  https://github.com/straylight-software/weapon-server-hs/issues

extra-doc-files:
  CONTRIBUTING.md
  docs/API.md
  docs/ARCHITECTURE.md
  README.md

source-repository head
  type:     git
  location: https://github.com/straylight-software/weapon-server-hs.git

