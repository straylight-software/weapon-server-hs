cabal-version: 3.0
name:          weapon-server
version:       0.1.0.0
synopsis:      Haskell server for Weapon AI coding agent
description:
  Haskell implementation of the Weapon AI coding agent server backend.
  .
  Features:
  .
  * Full API parity with TypeScript reference (95 endpoints)
  * Session management with persistent storage
  * LLM integration (Anthropic, OpenRouter)
  * Tool execution (read, write, edit, bash, glob, grep)
  * PTY terminals with WebSocket bridge
  * SSE event streaming
  * Sandboxed execution via bubblewrap

license:       MIT
license-file:  LICENSE
author:        Straylight Software
maintainer:    dev@straylight.ai
copyright:     2026 Straylight Software
category:      Web, AI
build-type:    Simple
homepage:      https://github.com/straylight-software/weapon-server-hs
bug-reports:   https://github.com/straylight-software/weapon-server-hs/issues

extra-doc-files:
  README.md
  CONTRIBUTING.md
  docs/API.md
  docs/ARCHITECTURE.md

source-repository head
  type:     git
  location: https://github.com/straylight-software/weapon-server-hs.git

-- ════════════════════════════════════════════════════════════════════════════
--                                                                  // library
-- ════════════════════════════════════════════════════════════════════════════

library
  exposed-modules:
    -- // agent
    Agent.Agent
    Agent.Types
    -- // api
    Api
    Api.Experimental
    Api.File
    Api.Message
    Api.Pty
    Api.Session
    Api.Tui
    Api.Types
    Handlers
    State
    -- // bus
    Bus.Bus
    Bus.Event
    -- // config
    Config.Config
    Config.Types
    -- // experimental
    Experimental.Worktree
    -- // find
    Find.Parse
    Find.Search
    -- // formatter
    Formatter.Status
    -- // global
    Global.Event
    -- // health
    Health.Build
    -- // llm
    LLM.Anthropic
    LLM.OpenRouter
    LLM.Types
    -- // log
    Log
    -- // middleware
    Middleware
    -- // lsp
    Lsp.Store
    -- // message
    Message.Parts
    Message.Todo
    Message.Types
    -- // path
    Path.Build
    -- // project
    Project.Build
    Project.Discovery
    -- // prompt
    Prompt.Async
    -- // provider
    Provider.OAuth
    Provider.Provider
    Provider.Types
    -- // proxy
    Proxy.Proxy
    Proxy.Types
    -- // pty
    Pty.Connect
    Pty.Parse
    Pty.Pty
    Pty.Types
    -- // request
    Request.Store
    -- // sandbox
    Sandbox.Sandbox
    Sandbox.Types
    -- // session
    Session.Session
    Session.Status
    Session.Types
    -- // skill
    Skill.Skill
    -- // storage
    Storage.Storage
    -- // tool
    Tool.Defs
    Tool.Exec
    Tool.Tool
    Tool.Types
    -- // tui
    Tui.Store
    -- // util
    Util.FileSystem
    Util.Git
    -- // vcs
    Vcs.Diff
    Vcs.Status

  hs-source-dirs:     src
  default-language:   GHC2021

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Werror
    -O2

  build-depends:
    , aeson               >=2.0
    , base                >=4.17 && <5
    , base64-bytestring   >=1.2
    , bytestring          >=0.11
    , case-insensitive    >=1.2
    , containers          >=0.6
    , crypton-connection  >=0.4
    , data-default-class  >=0.1
    , directory           >=1.3
    , filepath            >=1.4
    , http-client
    , http-client-tls
    , http-types          >=0.12
    , katip               >=0.8
    , mtl                 >=2.2
    , network             >=3.1
    , posix-pty           >=0.2
    , process             >=1.6
    , random              >=1.2
    , servant             >=0.20
    , servant-server      >=0.20
    , stm                 >=2.5
    , text                >=2.0
    , time                >=1.12
    , tls                 >=2.0
    , unix                >=2.8
    , unliftio-core       >=0.2
    , wai                 >=3.2
    , wai-websockets      >=3.0
    , warp                >=3.3
    , websockets          >=0.12

  default-extensions:
    BangPatterns
    DataKinds
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    StrictData
    TypeOperators

-- ════════════════════════════════════════════════════════════════════════════
--                                                               // executable
-- ════════════════════════════════════════════════════════════════════════════

executable weapon-server
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021

  ghc-options:
    -Wall
    -Wcompat
    -Werror
    -O2
    -threaded
    -rtsopts
    "-with-rtsopts=-N -T"

  build-depends:
    , aeson
    , base             >=4.17 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , http-types
    , katip
    , process
    , servant-server
    , stm
    , text
    , time
    , wai
    , wai-websockets
    , warp
    , weapon-server
    , websockets

  default-extensions:
    OverloadedStrings
    RecordWildCards

-- ════════════════════════════════════════════════════════════════════════════
--                                                               // test suite
-- ════════════════════════════════════════════════════════════════════════════

test-suite weapon-server-test
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     test
  default-language:   GHC2021

  ghc-options:
    -Wall
    -Wcompat
    -Werror
    -threaded
    -rtsopts
    "-with-rtsopts=-N"

  other-modules:
    -- // compatibility
    ApiCompatibilitySpec
    -- // integration
    Integration.ApiComplianceTest
    Integration.HaskemathesisTest
    -- // property tests
    Property.BusProps
    Property.ConfigProps
    Property.DiffProps
    Property.EventProps
    Property.ExperimentalProps
    Property.FindParseProps
    Property.FormatterProps
    Property.HandlerProps
    Property.HealthProps
    Property.LLMProps
    Property.LspProps
    Property.MessagePartProps
    Property.MessageProps
    Property.OAuthProps
    Property.OpenApiProps
    Property.PathProps
    Property.ProjectDiscoveryProps
    Property.ProjectProps
    Property.PromptAsyncProps
    Property.ProviderProps
    Property.PtyProps
    Property.RequestProps
    Property.SessionProps
    Property.SessionStatusProps
    Property.SkillProps
    Property.StorageProps
    Property.TodoProps
    Property.ToolProps
    Property.TuiProps
    Property.VcsStatusProps
    -- // unit tests
    Unit.ApiSpec

  build-depends:
    , aeson                 >=2.0
    , base                  >=4.17 && <5
    , base64-bytestring     >=1.2
    , bytestring            >=0.11
    , containers            >=0.6
    , directory             >=1.3
    , filepath              >=1.4
    , haskemathesis
    , hedgehog              >=1.4
    , hspec                 >=2.11
    , hspec-core            >=2.11
    , hspec-hedgehog        >=0.1
    , http-client
    , http-client-tls
    , http-types
    , katip                 >=0.8
    , openapi3              >=3.2
    , process
    , regex-pcre            >=0.95
    , servant               >=0.20
    , servant-server        >=0.20
    , stm                   >=2.5
    , tasty                 >=1.5
    , tasty-hedgehog        >=1.4
    , tasty-hspec           >=1.2
    , temporary             >=1.3
    , text                  >=2.0
    , transformers          >=0.6
    , unix                  >=2.8
    , unordered-containers  >=0.2
    , wai                   >=3.2
    , wai-extra             >=3.1
    , weapon-server

  default-extensions:
    DataKinds
    DeriveGeneric
    LambdaCase
    OverloadedStrings
    RecordWildCards
    TypeOperators
