  -- // evring-wai (io_uring bindings)
  c-sources:          cbits/uring_compat.c
  include-dirs:       cbits
  extra-libraries:    uring

  -- // agent
  -- // api
  -- // bus
  -- // config
  -- // experimental
  -- // find
  -- // formatter
  -- // global
  -- // health
  -- // llm
  -- // log
  -- // middleware
  -- // lsp
  -- // message
  -- // path
  -- // project
  -- // prompt
  -- // provider
  -- // proxy
  -- // pty
  -- // request
  -- // sandbox
  -- // session
  -- // skill
  -- // storage
  -- // tool
  -- // tui
  -- // util
  -- // vcs
  hs-source-dirs:     src
  default-language:   GHC2021
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
    -Werror -O2 -fwrite-ide-info -hiedir=.hie

  build-depends:
    , aeson               >=2.0
    , base                >=4.17 && <5
    , base64-bytestring   >=1.2
    , bytestring          >=0.11
    , case-insensitive    >=1.2
    , containers          >=0.6
    , crypton-connection  >=0.4
    , data-default-class  >=0.1
    , dhall               >=1.42
    , directory           >=1.3
    , filepath            >=1.4
    , http-client
    , http-client-tls
    , http-types          >=0.12
    , katip               >=0.8
    , mtl                 >=2.2
    , network             >=3.1
    , posix-pty           >=0.2
    , primitive           >=0.7
    , process             >=1.6
    , random              >=1.2
    , servant             >=0.20
    , servant-server      >=0.20
    , stm                 >=2.5
    , text                >=2.0
    , time                >=1.12
    , tls                 >=2.0
    , unix                >=2.8
    , unliftio-core       >=0.2
    , vault               >=0.3
    , vector              >=0.12
    , wai                 >=3.2
    , wai-websockets      >=3.0
    , warp                >=3.3
    , websockets          >=0.12

  default-extensions:
    BangPatterns
    DataKinds
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    StrictData
    TypeOperators

-- ════════════════════════════════════════════════════════════════════════════
--                                                               // executable
-- ════════════════════════════════════════════════════════════════════════════

executable weapon-server
  main-is:            Main.hs
  hs-source-dirs:     app
  default-language:   GHC2021
  ghc-options:
    -Wall -Wcompat -Werror -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
    -fwrite-ide-info -hiedir=.hie

  build-depends:
    , aeson
    , base            >=4.17 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , http-types
    , katip
    , process
    , servant-server
    , stm
    , text
    , time
    , wai
    , wai-websockets
    , warp
    , weapon-server
    , websockets

  default-extensions:
    OverloadedStrings
    RecordWildCards

